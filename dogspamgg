    while active_attacks.get(chat_id, False):
        for msg in full_1000_messages:
            if not active_attacks.get(chat_id, False):
                break
            await event.respond(msg, reply_to=reply_to_id)
            await asyncio.sleep(speed_delay)

# --- STOP COMMANDS ---
@client.on(events.NewMessage(pattern=r'/(stop|stopall|ungo|stopmegaspam|unsecret|stopuser|stopmultiple)'))
async def stop_handler(event):
    if event.sender_id not in ADMINS:
        return
    chat_id = event.chat_id
    active_attacks[chat_id] = False
    await event.respond("🛑 Spam Attack ကို ရပ်တန့်လိုက်ပါပြီ။")

# --- SPEED CONTROL COMMANDS (ALL SPEED MODES) ---
@client.on(events.NewMessage(pattern=r'/(setspeed|mode|fastest|godspeed|ultragodspeed|newgodrebornspeed|flashspeed|lightspeed|hyperspeed|instantspeed|normal|slow|burst|hyperburst|ultraburst|normalmode|zerodelay|smartzerodelay|ultimatezerodelay|smartattack|fastspeed|ludicrous|warpspeed|sonicspeed|turbomode|overdrive|rapidfire|blitzspeed|maxspeed|plaidspeed|supersonicspeed)'))
async def speed_handler(event):
    if event.sender_id not in ADMINS:
        return
    global speed_delay
    cmd = event.text.split()[0].lower()
    
    if cmd == '/setspeed':
        try:
            val = float(event.text.split()[1])
            speed_delay = val
            await event.respond(f"⚡ Speed ကို {speed_delay} စက္ကန့်သို့ ပြောင်းလိုက်ပါပြီ။")
            return
        except:
            await event.respond("❌ ဥပမာ: `/setspeed 0.05` ဟု ရိုက်ပေးပါ။")
            return

    # Ultra Fast Speeds (0.001s)
    if cmd in ['/zerodelay', '/smartzerodelay', '/ultimatezerodelay', '/ultragodspeed', '/instantspeed', '/ludicrous', '/plaidspeed', '/maxspeed']:
        speed_delay = 0.001
        await event.respond("⚡ Speed: Ultimate Zero Delay (0.001s)")
    # High Speeds (0.01s)
    elif cmd in ['/godspeed', '/flashspeed', '/lightspeed', '/hyperspeed', '/newgodrebornspeed', '/blitzspeed', '/rapidfire', '/overdrive', '/supersonicspeed']:
        speed_delay = 0.01
        await event.respond("⚡ Speed: God Speed (0.01s)")
    # Fast Speeds (0.05s)
    elif cmd in ['/fastest', '/fastspeed', '/warpspeed', '/sonicspeed', '/burst', '/hyperburst', '/ultraburst']:
        speed_delay = 0.05
        await event.respond("⚡ Speed: Fast Speed (0.05s)")
    # Normal Speeds (0.1s)
    elif cmd in ['/normal', '/normalmode', '/smartattack', '/mode']:
        speed_delay = 0.1
        await event.respond("⚡ Speed: Normal Speed (0.1s)")
    # Slow Speeds (0.5s)
    elif cmd == '/slow':
        speed_delay = 0.5
        await event.respond("⚡ Speed: Slow Speed (0.5s)")

