@client.on(events.NewMessage(pattern=r'/(removeowner|remove_admin)'))
async def remove_admin_handler(event):
    if event.sender_id != OWNER_ID:
        await event.respond("❌ Owner သာလျှင် ဖြုတ်ပိုင်ခွင့် ရှိပါသည်။")
        return
    if event.reply_to_msg_id:
        reply_msg = await event.get_reply_message()
        rem_id = reply_msg.sender_id
        if rem_id == OWNER_ID:
            await event.respond("❌ Main Owner ကို ဖြုတ်၍မရပါ။")
            return
        ADMINS.discard(rem_id)
        OWNERS.discard(rem_id)
        await event.respond(f"✅ User ID: `{rem_id}` ကို 권한/Admin မှ ဖြုတ်လိုက်ပါပြီ။")

