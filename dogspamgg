# --- REPLY ATTACK (/go သို့မဟုတ် /attack) ---
@client.on(events.NewMessage(pattern=r'/(go|attack|qa|quickattack|nuke|ultraattack)'))
async def attack_handler(event):
    if event.sender_id not in ADMINS:
        await event.respond("🚫 Admin Only Command.")
        return

    chat_id = event.chat_id
    if not event.reply_to_msg_id:
        await event.respond("❌ Target မက်ဆေ့ချ်ကို Reply ပြန်ပြီး Command ခေါ်ပေးပါ။")
        return

    reply_msg = await event.get_reply_message()
    target_msg_id = reply_msg.id
    
    # Target User ရဲ့ Name သို့မဟုတ် Username ယူခြင်း
    target_user = await reply_msg.get_sender()
    target_name = target_user.first_name if target_user and target_user.first_name else "Target"
    
    active_attacks[chat_id] = True
    
    # ပထမဆုံး စတင်ကြောင်း မက်ဆေ့ချ်
    await event.respond("ပညာမတက်သောခွေးမသားလေးကိုပညာသင်ပေးပါတော့မယ်", reply_to=target_msg_id)
    await asyncio.sleep(0.5)
    
    # စာကြောင်းများကို Target မက်ဆေ့ချ်အောက်တွင် မနားတမ်း Reply ပို့ပေးမည်
    while active_attacks.get(chat_id, False):
        for msg in full_1000_messages:
            if not active_attacks.get(chat_id, False):
                break
            
            send_text = f"{target_name} {msg}"
            await event.respond(send_text, reply_to=target_msg_id)
            await asyncio.sleep(speed_delay)

